{
  "version": 1,
  "scenarios": [
    {
      "id": "request-simple-direct",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy", "clarification_precision"],
      "request": "What is 17% of 240?",
      "objective": {
        "goal": "Calculate 17 percent of 240.",
        "deliverables": ["The calculated amount"],
        "successCriteria": ["Return the correct calculation."],
        "planningRequired": false
      },
      "expect": {
        "planningRequired": false,
        "clarificationRequired": false,
        "goalIncludes": ["17 percent", "240"]
      },
      "real": true
    },
    {
      "id": "planning-simple-request-skips-plan",
      "kind": "objective",
      "metrics": ["planning_validity", "unnecessary_model_calls"],
      "request": "Write one short sentence thanking the customer.",
      "objective": {
        "goal": "Write a concise thank-you sentence.",
        "deliverables": ["One thank-you sentence"],
        "planningRequired": false
      },
      "expect": {
        "planningRequired": false,
        "clarificationRequired": false
      },
      "real": true,
      "realObjectiveExpect": {
        "planningRequired": false,
        "clarificationRequired": false
      },
      "planExpect": { "expectSkipped": true },
      "manualReview": [
        "The request is simple enough to answer directly without planning."
      ]
    },
    {
      "id": "request-multiple-deliverables",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy"],
      "request": "Prepare a launch brief with a target audience, a three-channel campaign, a six-week schedule, and measurable success metrics.",
      "objective": {
        "goal": "Prepare a launch brief.",
        "deliverables": ["Target audience", "Three-channel campaign", "Six-week schedule", "Measurable success metrics"],
        "planningRequired": true
      },
      "expect": {
        "planningRequired": true,
        "clarificationRequired": false,
        "deliverableCountAtLeast": 4
      },
      "real": true,
      "realObjectiveExpect": {
        "planningRequired": true,
        "clarificationRequired": false
      },
      "planExpect": {
        "minimumTasks": 2,
        "requiredTerms": ["audience", "campaign", "schedule", "metrics"]
      }
    },
    {
      "id": "request-required-versus-optional",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy"],
      "request": "Draft a short CFO update. It must include the cash runway and avoid promising a specific growth rate. Optional: mention expansion ideas if space allows.",
      "objective": {
        "goal": "Draft a concise CFO update covering cash runway without promising a growth rate.",
        "deliverables": ["A short CFO update including the cash runway"],
        "instructions": ["Include the cash runway.", "Do not promise a specific growth rate."],
        "scopeConstraints": ["Keep the update short."],
        "planningRequired": false
      },
      "expect": {
        "planningRequired": false,
        "clarificationRequired": false,
        "instructionsInclude": ["cash runway", "do not promise a specific growth rate"],
        "deliverablesInclude": ["cash runway"],
        "deliverablesMustNotInclude": ["expansion ideas"]
      },
      "real": true,
      "manualReview": [
        "Required constraints are represented as mandatory instructions.",
        "The optional expansion suggestion is not promoted to a required deliverable."
      ]
    },
    {
      "id": "clarification-ambiguous-source",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy", "clarification_precision"],
      "request": "Make this more professional.",
      "objective": {
        "goal": "Revise the user's source text to use a professional tone.",
        "missingInformation": [{
          "item": "Source text",
          "reason": "No text to revise was provided.",
          "requiredFor": "drafting",
          "clarificationQuestion": "Please paste the text you want revised.",
          "safeAssumption": ""
        }]
      },
      "expect": {
        "clarificationRequired": true,
        "missingInformationIncludes": ["source text"]
      },
      "real": true
    },
    {
      "id": "clarification-hidden-business-assumption",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy", "clarification_precision"],
      "request": "Prepare a Q4 revenue forecast for my business.",
      "objective": {
        "goal": "Prepare a Q4 revenue forecast from the user's business data.",
        "missingInformation": [{
          "item": "Historical revenue or forecast assumptions",
          "reason": "No business data or forecast basis was supplied.",
          "requiredFor": "drafting",
          "clarificationQuestion": "Please provide historical revenue or the assumptions you want used.",
          "safeAssumption": ""
        }]
      },
      "expect": {
        "clarificationRequired": true,
        "missingInformationIncludes": ["revenue"]
      },
      "real": true
    },
    {
      "id": "clarification-conflicting-requirements",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy", "clarification_precision"],
      "request": "Write exactly 100 words, but keep the entire answer under 50 words.",
      "objective": {
        "goal": "Write a response that follows the requested length constraints.",
        "ambiguities": [{
          "kind": "conflict",
          "description": "Exactly 100 words conflicts with a maximum of 50 words.",
          "clarificationQuestion": "Which word limit should I follow?",
          "blocksDrafting": false,
          "blocksExecution": false
        }]
      },
      "expect": {
        "clarificationRequired": true,
        "clarificationQuestionIncludes": ["word limit"]
      },
      "real": true
    },
    {
      "id": "clarification-missing-document",
      "kind": "objective",
      "metrics": ["request_understanding_accuracy", "clarification_precision"],
      "request": "Summarize the attached contract.",
      "objective": {
        "goal": "Summarize the contract supplied by the user.",
        "missingInformation": [{
          "item": "Contract document",
          "reason": "No contract text or attachment was supplied.",
          "requiredFor": "drafting",
          "clarificationQuestion": "Please attach or paste the contract.",
          "safeAssumption": ""
        }]
      },
      "expect": {
        "clarificationRequired": true,
        "missingInformationIncludes": ["contract"]
      },
      "real": true
    },
    {
      "id": "clarification-execution-only-recipient",
      "kind": "objective",
      "metrics": ["clarification_precision"],
      "request": "Draft an email announcing the schedule change; I will send it after review.",
      "objective": {
        "goal": "Draft an email announcing a schedule change.",
        "missingInformation": [{
          "item": "Recipient",
          "reason": "The recipient is not needed to draft but is required to send.",
          "requiredFor": "execution",
          "clarificationQuestion": "Who should receive the email before sending?",
          "safeAssumption": "Use a recipient placeholder in the draft."
        }],
        "planningRequired": false,
        "requiresExternalAction": false
      },
      "expect": {
        "clarificationRequired": false,
        "confirmationRequiredBeforeExecution": true
      }
    },
    {
      "id": "planning-independent-work",
      "kind": "plan",
      "metrics": ["planning_validity", "dependency_accuracy", "specialist_assignment_accuracy"],
      "request": "Analyze customer segments and calculate the projected quarterly totals independently.",
      "plan": {
        "tasks": [
          {
            "id": "segments",
            "description": "Analyze customer segments.",
            "type": "analysis",
            "requiredCapability": "reasoning"
          },
          {
            "id": "quarterly-totals",
            "description": "Calculate projected quarterly totals.",
            "type": "calculation",
            "requiredCapability": "calculation"
          }
        ]
      },
      "expect": {
        "valid": true,
        "taskCount": 2,
        "dependencyEdges": [],
        "assignmentValid": true
      },
      "real": true,
      "realObjectiveExpect": {
        "planningRequired": true,
        "clarificationRequired": false
      },
      "planExpect": {
        "minimumTasks": 2,
        "independentTaskTerms": ["segments", "quarterly"],
        "checkSpecialistAssignment": true
      }
    },
    {
      "id": "planning-dependent-synthesis",
      "kind": "plan",
      "metrics": ["planning_validity", "dependency_accuracy"],
      "request": "Compare the two options and recommend one based on the comparison.",
      "plan": {
        "tasks": [
          {
            "id": "recommend",
            "description": "Recommend one option using the comparison.",
            "dependencies": ["compare"],
            "requiredInputs": [{
              "kind": "task_output",
              "description": "Comparison results",
              "sourceTaskId": "compare"
            }]
          },
          {
            "id": "compare",
            "description": "Compare the two options."
          }
        ]
      },
      "expect": {
        "valid": true,
        "dependencyEdges": [["recommend", "compare"]]
      },
      "real": true,
      "realObjectiveExpect": {
        "planningRequired": true,
        "clarificationRequired": false
      },
      "planExpect": {
        "minimumTasks": 2,
        "requiredTerms": ["compare", "recommend"],
        "dependencyTermPairs": [["recommend", "compare"]]
      }
    },
    {
      "id": "planning-covers-every-deliverable",
      "kind": "plan",
